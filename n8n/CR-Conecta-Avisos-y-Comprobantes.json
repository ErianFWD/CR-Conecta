      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst base = $('Decidir envíos').first().json;\nconst rejected = Array.isArray(result.rejected) && result.rejected.length > 0;\nconst accepted = Array.isArray(result.accepted) && result.accepted.length > 0;\nconst ok = !result.error && !rejected && accepted;\nreturn [{ json: { EventId: base.eventId,\n  EstadoCorreo: ok ? 'Enviado' : 'Error', FechaEnvio: ok ? new Date().toISOString() : '',\n  ErrorCorreo: ok ? '' : 'SMTP no confirmó aceptación. Revisá la ejecución antes de reintentar.' } }];"
