    {
      "name": "Configurar y validar donación",
      "id": "cr-4",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        440
      ],
      "parameters": {
        "jsCode": "// Cambiá SOLO estos valores al importar. No pongás contraseñas aquí.\nconst config = {\n  remitente: 'avisos@ejemplo.invalid',\n  correoEquipo: 'equipo@ejemplo.invalid',\n  spreadsheetId: 'PEGA_AQUI_EL_ID_DE_GOOGLE_SHEETS',\n  sheetName: 'Donaciones',\n  consultarHaciendaSiempre: true\n};\nconst body = $input.first().json.body;\nconst d = body?.data;\nif (body?.type !== 'donation.registered' || !/^DON-[A-Z0-9-]+$/i.test(d?.id || '') || !d?.product || body.eventId !== `donation.registered:${d.id}`) throw new Error('Evento de donación inválido');\nconst email = String(d.recipient?.email || '').trim();\nif (!/^[^\\s@,;<>]+@[^\\s@,;<>]+\\.[^\\s@,;<>]+$/.test(email)) throw new Error('La cuenta del donante necesita un correo válido');\nif (config.spreadsheetId.startsWith('PEGA_') || [config.remitente, config.correoEquipo].some(e => e.endsWith('.invalid'))) throw new Error('Completá remitente, correoEquipo y spreadsheetId en este nodo');\nconst name = String(d.recipient?.name || '').trim().slice(0, 120);\nconst identification = String(d.recipient?.identification || '').trim();\nreturn [{ json: { eventId: body.eventId, occurredAt: body.occurredAt, donation: d, email, registeredName: name, identification, config,\n  consultarHacienda: /^\\d{9,12}$/.test(identification) && (config.consultarHaciendaSiempre || !name) } }];"
      }
    },
