    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cr-conecta-solicitud-aprobada",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "cr-approval-webhook",
      "name": "Solicitud aprobada",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        160
      ],
      "webhookId": "cr-conecta-solicitud-aprobada"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nif (body?.type !== 'request.approved' || !body.data?.id || !body.data?.category) throw new Error('Evento de aprobación inválido');\nconst d = body.data;\nconst esc = value => String(value ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nreturn [{ json: { subject: `CR Conecta: necesidad aprobada #${d.id}`, html: `<h2>Necesidad lista para recibir donaciones</h2><p><strong>Solicitud:</strong> ${esc(d.id)}</p><p><strong>Categoría:</strong> ${esc(d.category)}</p><p><strong>Zona:</strong> ${esc(d.zone)}</p><p><strong>Cantidad:</strong> ${esc(d.amount)} ${esc(d.unit)}</p><p><strong>Prioridad:</strong> ${esc(d.priority)}</p><p>Revisá la necesidad aprobada en CR Conecta antes de coordinar aportes.</p><small>Aviso de un prototipo académico; datos simulados.</small>` } }];"
      },
      "id": "cr-format-approval",
      "name": "Preparar aviso de necesidad",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        160
      ]
    },
    {
      "parameters": {
        "fromEmail": "avisos@ejemplo.invalid",
        "toEmail": "equipo@ejemplo.invalid",
        "subject": "={{ $json.subject }}",
        "html": "={{ $json.html }}",
        "options": {},
        "emailFormat": "html"
      },
