      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1640,
        440
      ],
      "parameters": {
        "jsCode": "const base = $('Preparar aviso y comprobante').first().json;\nconst rows = $input.all().map(item => item.json).filter(row => row.EventId === base.eventId);\nif (rows.length > 1) throw new Error('Hay filas duplicadas para este EventId. Revisá Sheets antes de reenviar');\nconst previous = rows[0] || {};\nconst row = { ...base.row };\nfor (const key of ['EstadoCorreo','FechaEnvio','ErrorCorreo','EstadoEquipo','FechaEquipo','ErrorEquipo']) {\n  if (previous[key] !== undefined && previous[key] !== '') row[key] = previous[key];\n}\nreturn [{ json: { ...base, row, enviarDonante: row.EstadoCorreo !== 'Enviado', enviarEquipo: row.EstadoEquipo !== 'Enviado' } }];"
      }
    },
