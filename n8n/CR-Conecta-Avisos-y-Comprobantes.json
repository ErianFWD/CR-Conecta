    {
      "name": "Preparar aviso y comprobante",
      "id": "cr-7",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1190,
        440
      ],
      "parameters": {
        "jsCode": "const base = $('Configurar y validar donación').first().json;\nconst response = $input.first().json;\nconst haciendaName = typeof response.nombre === 'string' ? response.nombre.trim().slice(0, 120) : '';\nconst name = haciendaName || base.registeredName || 'donante';\nconst d = base.donation;\nconst esc = value => String(value ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst summary = `<p><strong>Fecha:</strong> ${esc(d.date)}</p><p><strong>Producto:</strong> ${esc(d.product)}</p><p><strong>Categoría:</strong> ${esc(d.category)}</p><p><strong>Cantidad:</strong> ${esc(d.quantity)}</p><p><strong>Destino:</strong> ${esc(d.destination)}</p><p><strong>Estado:</strong> ${esc(d.status)}</p>`;\nconst html = `<div style=\"font-family:Arial,sans-serif;color:#123452;max-width:640px;margin:auto\"><h2 style=\"color:#1763a0\">Comprobante de registro ${esc(d.id)}</h2><p>Hola ${esc(name)}:</p><p>Gracias por apoyar a CR Conecta. Recibimos el registro de tu donación. El aporte está pendiente de coordinación.</p>${summary}<p>Conservá este correo para el seguimiento de tu aporte.</p><hr><small>Este comprobante registra el aporte; no confirma recepción física, entrega ni beneficio fiscal.</small></div>`;\nconst teamHtml = `<h2>Nuevo aporte registrado #${esc(d.id)}</h2><p>Donante: ${d.anonymous ? 'Anónimo' : esc(name)}</p>${summary}<p>Revisá el aporte en CR Conecta para coordinar su seguimiento.</p>`;\n// Evita interpretar texto del donante como fórmulas de Sheets.\nconst textCell = value => { const text = String(value ?? ''); return /^[=+@\\-\\t\\r\\n]/.test(text.trimStart()) ? \"'\" + text : text; };\nconst row = {\n  EventId: base.eventId, DonacionId: d.id, FechaRegistro: d.date,\n  Nombre: d.anonymous ? 'Anónimo' : textCell(name), Correo: d.anonymous ? '' : textCell(base.email),\n  Producto: textCell(d.product), Categoria: textCell(d.category), Cantidad: Number(d.quantity),\n  Destino: textCell(d.destination), Provincia: textCell(d.province), Canton: textCell(d.canton),\n  Anonima: d.anonymous ? 'Sí' : 'No', FuenteNombre: d.anonymous ? 'Privado' : haciendaName ? 'Hacienda' : 'Registro',\n  EstadoCorreo: 'Pendiente', FechaEnvio: '', ErrorCorreo: '', EstadoEquipo: 'Pendiente', FechaEquipo: '', ErrorEquipo: ''\n};\n// La cédula no pasa a la hoja ni a los correos.\nreturn [{ json: { eventId: base.eventId, config: base.config, email: base.email, name,\n  subject: `CR Conecta: comprobante de registro ${d.id}`, html,\n  teamSubject: `CR Conecta: nueva donación ${d.id}`, teamHtml, row } }];"
      }
    },
